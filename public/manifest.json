{
  "manifest_version": 3,
  "name": "Local Music Log",
  "version": "0.2.0",
  "description": "Local playback history with optional broadcaster-approved Twitch metadata sharing.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local Music Log"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
